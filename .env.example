# 复制本文件为 .env，填入你自己的 key（三选一，推荐Vercel免费路线）
# .env 已在 .gitignore 中，不会被提交

# 方式A（推荐，免费）：Vercel AI Gateway——每月$5免费额度、无需绑卡
#   vercel.com 注册（GitHub登录）→ 控制台 AI Gateway → API Keys 创建
AI_GATEWAY_API_KEY=

# 方式B：TypeSafe 直连（注册开放时，console.typesafe.ai/keys 获取）
TYPESAFE_API_KEY=

# 方式C：OpenRouter 网关（需充值$5，openrouter.ai/keys 获取）
OPENROUTER_API_KEY=
